# ─── Python Bytecode ───────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.pyd
*.pyw
*.egg-info/
dist/
build/
.eggs/

# ─── Virtual Environments ──────────────────────────────────────────────────────
.venv/
venv/
ENV/
env/
.env/
ps1/

# ─── Trained Models (generated by running scripts/) ────────────────────────────
models/*.pkl
models/*.h5
models/*.pt
models/*.bin
models/*.csv
!models/.gitkeep
# Keep the neural net checkpoint for the Research Demo tab
!models/network_risk_classifier.pth

# ─── Dataset Files ────────────────────────────────────────────────────────────
data/**
!data/
!data/.gitkeep
!data/demo_samples.npy
!data/combined_traffic.csv
!data/benign_traffic.csv

# ─── Dataset caches ───────────────────────────────────────────────────────────
data/cicids-2017/.cache/

# ─── Experiment Outputs (generated by running scripts/) ───────────────────────
results/*.json
results/*.csv
results/*.png
results/*.pdf
!results/.gitkeep

# ─── Runtime Logs (written during dashboard / experiment execution) ────────────
logs/sessions/
logs/analytics/
logs/attacks/
logs/*.json
logs/*.log
logs/*.txt
logs/*.csv
*.log
!logs/.gitkeep

# ─── Streamlit ─────────────────────────────────────────────────────────────────
.streamlit/*
!.streamlit/config.toml

# ─── Jupyter ───────────────────────────────────────────────────────────────────
.ipynb_checkpoints/

# ─── Testing ───────────────────────────────────────────────────────────────────
.pytest_cache/
pytest_output.txt

# ─── Secrets and Environment Variables ────────────────────────────────────────
.env
*.env
secrets.toml

# ─── OS Generated Files ────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
*.swp
*~
*.code-workspace
